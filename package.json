{
  "name": "support-buddy-demo-product",
  "version": "1.0.0",
  "private": true,
  "description": "Fictional SaaS platform used as a target for Support Buddy X9000 Devin integration testing",
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:auth": "cd services/auth-service && npm test",
    "test:webhook": "cd services/webhook-dispatcher && npm test",
    "test:order": "cd services/order-service && npm test",
    "test:billing": "cd services/billing-service && npm test",
    "test:rate-limiter": "cd services/rate-limiter && npm test",
    "test:database": "cd services/database-client && npm test",
    "lint": "echo 'no global lint configured'"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@types/node": "^20.14.0"
  }
}
